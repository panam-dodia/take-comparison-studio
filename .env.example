# true = use MockProvider/MockVideoProvider, zero API cost, zero API keys needed
# false = hit real GMI Cloud endpoints and spend budget
GENBLAZE_MOCK=true

# Backblaze B2 (S3-compatible) — leave blank to run pipeline without a storage sink
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=
B2_REGION=us-west-004

# Only required when GENBLAZE_MOCK=false
GMI_API_KEY=
